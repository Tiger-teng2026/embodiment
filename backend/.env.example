# 自用登录。对外暴露前先改掉密码和密钥。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=embodiment
SECRET_KEY=change-me-before-any-shared-deploy

# 容器内 Redis。指向别的机器时改成那台的地址。
REDIS_URL=redis://127.0.0.1:6379/0
GPU_DEVICE_ID=0

# MinIO 不在 API 容器里。这组值和 docker-compose 里的本地 MinIO 一致。
# Runpod 上改成 Pod 能访问的地址和你自己的密钥，不要用 localhost。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=embodiment
MINIO_SECURE=false
# 浏览器下载用的地址。和 MINIO_ENDPOINT 不同时再填，例如公网域名:9000。
# MINIO_PUBLIC_ENDPOINT=

# 前端页面来源。本地 Vite 默认是下面两个。多个用逗号隔开，星号表示不限制。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 一般不用改。权重和示例驱动视频随镜像放在这里。
# LIVEPORTRAIT_HOME=/opt/LivePortrait
# LIVEPORTRAIT_DRIVING=
# FONT_PATH=
# DATABASE_URL=sqlite:////data/embodiment.db
